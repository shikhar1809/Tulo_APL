{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "tulo",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      ".git/**",
      ".firebase/**",
      "**/node_modules/**",
      "config.local.js",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "prd.md",
      "spec.md",
      "design (2).md"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css|svg)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions"
  }
}