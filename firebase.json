{
  "hosting": {
    "site": "tulo",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "config.local.js",
      "prd.md",
      "spec.md",
      "design (2).md"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css|svg)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
